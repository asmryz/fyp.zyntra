erDiagram
    %% table name: alembic_version
    %% table comment: 
    alembic_version {
        character_varying(32) version_num PK ""
    }

    %% table name: audit_logs
    %% table comment: 
    audit_logs {
        integer id PK ""
        integer actor_id FK ""
        character_varying(120) actor_name  ""
        character_varying(20) category  ""
        character_varying(60) action  ""
        character_varying(40) entity_type  ""
        integer entity_id  ""
        character_varying(300) summary  ""
        timestamp_with_time_zone created_at  ""
    }

    %% table name: auth_codes
    %% table comment: 
    auth_codes {
        integer id PK ""
