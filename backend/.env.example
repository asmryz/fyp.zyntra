# Copy this file to .env and replace the dummy values. Never commit .env.

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require

# Gmail SMTP (use a Google App Password, not the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=zyntra.szabist@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=zyntra.szabist@gmail.com
SMTP_FROM_NAME=ZYNTRA

# Address of the React app (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# true when the site is served over HTTPS
COOKIE_SECURE=false
# smtp = send real emails, outbox = save emails to backend/dev_outbox (local testing only)
EMAIL_BACKEND=smtp

# Optional: URL of the LangGraph/RAG assistant service (POST {AI_SERVICE_URL}/ask)
AI_SERVICE_URL=
# Optional: WhatsApp number of the whatsapp-web.js bot, digits only with country code, e.g. 923001234567
WHATSAPP_NUMBER=
